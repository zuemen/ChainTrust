# === ChainTrust 根目錄環境變數 ===
# 這份只給 `docker compose` 用（compose 會自動讀同目錄的 .env）。
# 單一套件本機開發請看 packages/issuer-verifier/.env.example。
#
#   cp .env.example .env
#   docker compose up --build
#
# .env 已被 .gitignore 擋住，絕對不要入庫。

# ---------------------------------------------------------------
# 安全（最重要）
# ---------------------------------------------------------------
# mutating 端點（/revoke、/sdjwt/issue、/issue/*）的守門金鑰。
# 留空 = dev 模式不設防：同一台機器上任何程式都能撤銷憑證或簽發假 KYC。
# 正式 demo 一律要設；產生方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 設了之後，呼叫端要帶 header  X-API-Key: <同一個值>
# scripts/smoke.mjs 會自動讀這個環境變數並附上 header。
API_KEY=

# CORS 允許來源（逗號分隔或單一 origin）。預設只放行錢包前端。
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------
# 鏈設定
# ---------------------------------------------------------------
# memory = 離線模擬信任根（自蓋章，僅供 demo/e2e）
# ethers = 接已部署到 Polygon Amoy 的合約（見 docs/amoy-deploy-checklist.md）
CHAIN_MODE=memory
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# 撤銷 / 設信任 issuer 需要簽署私鑰（**只用 testnet 測試錢包**，絕不入庫）；留空則唯讀
CHAIN_PRIVATE_KEY=
