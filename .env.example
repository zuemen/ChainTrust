# === ChainTrust 根目錄環境變數 ===
# 這份只給 `docker compose` 用（compose 會自動讀同目錄的 .env）。
# 單一套件本機開發請看 packages/issuer-verifier/.env.example。
#
#   cp .env.example .env
#   docker compose up --build
#
# .env 已被 .gitignore 擋住，絕對不要入庫。

# ---------------------------------------------------------------
# 安全（最重要）
# ---------------------------------------------------------------
# mutating 端點（/revoke、/sdjwt/issue、/issue/*）的守門金鑰。
# 這是 fail-closed 的：**留空時 mutating 端點一律回 503**（不是放行）。
# 產生方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 誰會帶這個 header：
#   - scripts/smoke.mjs 直接讀本環境變數附上。
#   - 錢包前端「不帶」——它是公開客戶端，打包進 JS 的金鑰按 F12 就看得到。
#     金鑰由反向代理注入：dev 是 vite proxy（packages/wallet/vite.config.ts），
#     prod 是 nginx（packages/wallet/nginx.conf.template，compose 以
#     CHAINTRUST_API_KEY 帶入）。瀏覽器從頭到尾看不到金鑰。
#   - `pnpm demo` 若偵測到本變數為空，會自動產生一把只活在該次行程的一次性金鑰。
API_KEY=

# CORS 允許來源（逗號分隔或單一 origin）。預設只放行錢包前端。
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------
# 鏈設定
# ---------------------------------------------------------------
# memory = 離線模擬信任根（自蓋章，僅供 demo/e2e）
# ethers = 接已部署到 Polygon Amoy 的合約（見 docs/amoy-deploy-checklist.md）
CHAIN_MODE=memory
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# 撤銷 / 設信任 issuer 需要簽署私鑰（**只用 testnet 測試錢包**，絕不入庫）；留空則唯讀
CHAIN_PRIVATE_KEY=
