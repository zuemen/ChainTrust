# 複製為 .env（已被 .gitignore，勿入庫）
PORT=3001

# 鏈模式：memory（離線 e2e/dev，預設）| ethers（接已部署合約）
CHAIN_MODE=memory

# 接真合約時用
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# 信任根 owner（setTrustedIssuer）的簽署私鑰（測試錢包，僅 testnet，勿入庫）；缺則唯讀
CHAIN_PRIVATE_KEY=

# --- 發證者金鑰（選填，強烈建議設定）---------------------------
# 設定後發證者 DID 固定：服務重啟（含免費 PaaS 休眠喚醒）時，使用者手上的憑證不會失效。
# ethers 模式下撤銷交易由發證者自己的金鑰送出（RevocationRegistry 以送交易者位址為撤銷命名空間），
# 銀行 A 未設時沿用 CHAIN_PRIVATE_KEY。產生方式：
#   node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
ISSUER_PRIVATE_KEY=
# 中華電信（門號實名、繳費信譽）發證者；未設則每次啟動隨機產生、且無法上鏈撤銷其憑證
CHT_ISSUER_PRIVATE_KEY=
ETHR_NETWORK=polygon:amoy
ETHR_CHAIN_ID=80002

# AI 反詐服務（M2）
AI_SERVICE_URL=http://localhost:8000

# 階段 C：安全
# mutating 端點（/issue/*、/sdjwt/issue、/revoke）的 API 金鑰。
# fail-closed：留空時這些端點直接回 503 停用，不會放行。
API_KEY=
# 僅限本機離線 PoC：設為 true 且 CHAIN_MODE=memory 時，才允許沒有 API_KEY 也能呼叫
# mutating 端點。任何對外部署都不要開這個。
ALLOW_UNAUTHENTICATED_DEV=false
# CORS 允許來源（預設僅錢包前端）
CORS_ORIGIN=http://localhost:5173
# 本驗證方 aud 識別（key binding 用）
VERIFIER_AUD=chaintrust-verifier

# --- AI 反詐服務的逾時與暖機 ---------------------------------
# 免費方案的 PaaS（Render 等）閒置 15 分鐘會休眠，冷啟動實測 33–50 秒。
# 逾時若短於冷啟動時間，服務睡著後就再也醒不過來（每次請求都在開機完成前被
# 中斷），反詐功能會永久停在「不可用」。以下三個值的預設已能自行恢復。
# AI_TIMEOUT_MS=15000          # /score：使用者在等，逾時要有上限（降級成 review）
# AI_METRICS_TIMEOUT_MS=60000  # /metrics：錢包載入時呼叫，兼作叫醒 AI 的路徑
# AI_WARMUP_TIMEOUT_MS=60000   # 啟動時送一次長逾時 /health；0 為關閉
# 現場 demo 建議打開 keepalive（例如 600000 = 10 分鐘），避免展示到一半睡著
# AI_KEEPALIVE_MS=600000
